<?xml version="1.0" encoding="utf-8"?>
<!--
  Layers are generated by tools/IconGen.java from one piece of artwork; do not hand-edit the
  PNGs. The background is the full blue field, the foreground the card stack scaled to sit
  inside the 66dp safe circle, and the monochrome a flat silhouette of that stack.

  The monochrome layer is deliberately NOT the colour artwork: Android tints whatever it finds
  there to a single colour for themed icons, and a gradient image comes out as a featureless
  blob.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
