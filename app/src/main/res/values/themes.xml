<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- NoActionBar: every screen supplies its own MaterialToolbar, and a decor-provided
         action bar would collide with setSupportActionBar at runtime. -->
    <style name="Theme.MyCards" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <!-- Matches the toolbar rather than the accent, which is light in dark mode. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/toolbar_background</item>
    </style>

    <!--
        The toolbar is a solid brand blue in both themes, so everything drawn on it has to be
        light in both themes. Only the title took its colour from titleTextColor; the
        navigation arrow and the overflow dots inherited colorOnSurface/colorOnSurfaceVariant
        from the app theme, which is near-white in dark mode but near-black in light mode —
        so in light mode they turned dark on dark blue and all but disappeared.

        Applied as android:theme on each toolbar rather than in the app theme, so it recolours
        the toolbar's own contents and nothing else on the screen.
    -->
    <style name="ThemeOverlay.MyCards.Toolbar" parent="">
        <item name="colorOnSurface">@color/toolbar_on_background</item>
        <item name="colorOnSurfaceVariant">@color/toolbar_on_background</item>
        <item name="android:textColorPrimary">@color/toolbar_on_background</item>
        <item name="android:textColorSecondary">@color/toolbar_on_background</item>
    </style>

    <!--
        The overflow menu's own theme, and it has to be stated separately or the overlay
        above swallows it.

        A Toolbar hands its android:theme down to the popup it opens, which is reasonable
        for a toolbar whose popup shares its background and catastrophic for one whose does
        not. Ours is the second kind: the overlay paints every foreground white so it can sit
        on solid blue, and the popup then drew white text on the light popup surface. The
        items were still there, still tappable, entirely invisible — and only in light mode,
        because a dark popup surface hid the fault completely.

        "Delete card" was the exception that disguised it: CardDetailActivity tints that one
        item red in code, so the menu always had exactly one readable row and looked more
        like a deliberate style than a bug.

        Kept as explicit day/night colours rather than inherited, because inheriting is what
        went wrong in the first place.
    -->
    <style name="ThemeOverlay.MyCards.Popup" parent="">
        <item name="colorOnSurface">@color/popup_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/popup_on_surface_variant</item>
        <item name="android:textColorPrimary">@color/popup_on_surface</item>
        <item name="android:textColorSecondary">@color/popup_on_surface_variant</item>
    </style>

    <!-- Balances are the thing you scan for at a checkout counter, so they get their own scale. -->
    <style name="TextAppearance.MyCards.Amount" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MyCards.CardTitle" parent="TextAppearance.Material3.TitleMedium" />

    <style name="TextAppearance.MyCards.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:alpha">0.75</item>
    </style>

    <!-- Monospace keeps a 16-digit number readable while typing it into a terminal. -->
    <style name="TextAppearance.MyCards.Secret" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

</resources>
