    <string name="backup_import_result_title">Cards restored</string>
    <string name="backup_import_incomplete_title">Restore incomplete</string>
    <string name="backup_import_nothing_title">Nothing was restored</string>
    <!-- Leads the dialog when a restore applied nothing. It is stated as the outcome rather
         than as a footnote, and it says outright that the backup remains untested, because
         reading this screen as proof that a backup file works is what cost a wallet. -->
    <string name="backup_import_changed_nothing">Not one card or purchase from this file was put back. Every card in it is already on this phone in a newer form, so there was nothing to restore.\n\nThis does not tell you whether the backup is any good. A backup is only proved by restoring it where the cards are missing.</string>
    <string name="backup_import_file_holds">The file holds %1$d cards and %2$d purchases.</string>
    <string name="backup_import_outcome">Added: %1$d\nUpdated: %2$d\nAlready on this phone: %3$d\nPurchases added: %4$d</string>
    <string name="backup_import_some_failed">%1$d cards in the file could not be restored. Everything else was.</string>
    <string name="backup_import_kept_secrets">%1$d cards were updated from the file, but it had no copy of their card number, CVV or gift link, so what was already on this phone was kept.</string>
    <string name="backup_import_spends_dropped">%1$d purchases in the file were not restored, because the cards they belong to are not on this phone.</string>
    <string name="backup_import_needs_unlock">Unlocking is needed to restore card numbers. Nothing was changed.</string>
    <string name="backup_empty">This backup holds no cards at all. It was created but never filled in — do not rely on it.</string>
