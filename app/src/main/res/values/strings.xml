    <!-- Backup -->
    <string name="backup">Backup</string>
    <string name="backup_explain">Your cards live only on this phone. Export an encrypted backup so a lost or replaced phone does not mean losing them.</string>
    <string name="backup_export">Export encrypted backup</string>
    <string name="backup_import">Restore from a backup</string>
    <!-- Confirm buttons on the passphrase dialog. "Save" was misleading on a restore:
         nothing is being saved, and the word suggests the passphrase is being remembered. -->
    <string name="backup_export_action">Export</string>
    <string name="backup_import_action">Restore</string>
    <string name="backup_passphrase">Passphrase</string>
    <string name="backup_passphrase_confirm">Repeat the passphrase</string>
    <string name="backup_passphrase_explain">Encrypts the file. There is no way to recover it if you forget it — not even by reinstalling the app.</string>
    <string name="backup_passphrase_mismatch">The two passphrases do not match</string>
    <string name="backup_passphrase_too_short">Use at least 8 characters</string>
    <!-- Reports counts rather than a bare "saved", so an empty backup is obvious immediately
         instead of at the moment it is needed. -->
    <string name="backup_exported_count">Backup saved: %1$d cards, %2$d purchases</string>
    <string name="backup_export_failed">Could not create the backup</string>
    <string name="backup_export_failed_body">Something went wrong while writing the backup, so nothing was saved.</string>
    <string name="backup_export_needs_unlock">Unlocking is needed to include your card numbers, so nothing was saved.</string>
    <string name="backup_export_unlock_expired">The unlock expired before the backup was ready, so nothing was saved. Please try again.</string>
    <string name="backup_nothing_to_export">There are no cards to back up yet.</string>
    <string name="backup_leftover_file">An empty file may be left where you chose to save it. Delete it, so it is never mistaken for a backup.</string>
    <string name="backup_export_partial_title">Backup saved, with gaps</string>
    <string name="backup_export_partial_body">%1$d cards and %2$d purchases were saved.\n\n%3$d of those cards could not include their card number, CVV or gift link. Those are locked to this phone\'s screen lock, and it has changed since they were saved, so the app can no longer read them. Everything else is in the file.</string>
    <string name="backup_check">Check a backup file</string>
    <string name="backup_check_action">Check</string>
    <string name="backup_check_ok_title">Backup checked</string>
    <string name="backup_check_bad_title">Backup is incomplete</string>
    <string name="backup_check_covers">This backup would bring back all %1$d of the cards on this phone.</string>
    <string name="backup_check_incomplete">This backup would NOT bring back everything on this phone.</string>
    <string name="backup_check_contents">It holds %1$d cards and %2$d purchases. %3$d of the cards include a card number, CVV or gift link.</string>
