<?xml version="1.0" encoding="utf-8"?>
<!--
    The custom card colour.

    The preview is the point of the dialog, not decoration. Three sliders describe a colour
    in a form nobody can picture, and the thing being chosen is not the colour but the card:
    the gradient it turns into, and whether the balance printed on it can still be read. So
    the preview is a real card face carrying real card text, built by exactly the code the
    wallet will use.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/previewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/face_color_preview_title"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.MyCards.CardTitle"
            android:textColor="@color/on_face" />

        <TextView
            android:id="@+id/previewAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.MyCards.Amount"
            android:textColor="@color/on_face"
            tools:text="₪250" />

        <TextView
            android:id="@+id/previewMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/face_color_preview_meta"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.MyCards.Meta"
            android:textColor="@color/on_face_variant" />
    </LinearLayout>

    <TextView
        android:id="@+id/redLabel"
        style="@style/TextAppearance.MyCards.ColorChannel"
        android:layout_marginTop="16dp"
        tools:text="Red 180" />

    <com.google.android.material.slider.Slider
        android:id="@+id/red"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/face_color_red"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="255" />

    <TextView
        android:id="@+id/greenLabel"
        style="@style/TextAppearance.MyCards.ColorChannel"
        tools:text="Green 50" />

    <com.google.android.material.slider.Slider
        android:id="@+id/green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/face_color_green"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="255" />

    <TextView
        android:id="@+id/blueLabel"
        style="@style/TextAppearance.MyCards.ColorChannel"
        tools:text="Blue 92" />

    <com.google.android.material.slider.Slider
        android:id="@+id/blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/face_color_blue"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="255" />
</LinearLayout>
