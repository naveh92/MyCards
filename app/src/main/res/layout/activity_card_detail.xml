<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/toolbar_background"
            android:theme="@style/ThemeOverlay.MyCards.Toolbar"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/card_details"
            app:titleTextColor="@color/toolbar_on_background" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingBottom="96dp">

                <TextView
                    android:id="@+id/cardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:id="@+id/cardSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.MyCards.Meta" />

                <TextView
                    android:id="@+id/balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAlignment="viewStart"
                    android:textAppearance="?attr/textAppearanceDisplaySmall" />

                <TextView
                    android:id="@+id/balanceMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.MyCards.Meta" />

                <TextView
                    android:id="@+id/expiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAlignment="viewStart"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mismatchCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/expiry_warning"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/unlogged_transaction_title"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="@color/expiry_warning" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/reconcileButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reconcile_add" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- The doorway to the merchant list. It used to be a tap on the card name
                     above, which nobody discovers; a row of its own makes the affordance
                     plain, and stating the count puts a fact worth knowing on the screen
                     instead of leaving it buried in a dialog. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/storeListCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/storeListTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAlignment="viewStart"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <TextView
                                android:id="@+id/storeListMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAlignment="viewStart"
                                android:textAppearance="@style/TextAppearance.MyCards.Meta" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/storeListChevron"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_end" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sensitive block: hidden until the OS confirms who is holding the phone. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/revealButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/show_card_number" />

                <LinearLayout
                    android:id="@+id/secretBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/panValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.MyCards.Secret"
                        android:textIsSelectable="true" />

                    <!-- Number, expiry, then CVV — the order they are printed on the card
                         and the order a payment form asks for them. -->
                    <TextView
                        android:id="@+id/cardExpiryValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.MyCards.Secret"
                        android:textIsSelectable="true" />

                    <TextView
                        android:id="@+id/cvvValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.MyCards.Secret"
                        android:textIsSelectable="true" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/giftLinkButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_gift_link"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/spend_log"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/noSpends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/no_spends_yet"
                    android:textAppearance="@style/TextAppearance.MyCards.Meta" />

                <!-- The clearance for the floating button belongs on the scrolling
                     container, not here: padding on the list itself is drawn as part of
                     the list, showing up as a slab of dead space under the last entry. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/spendList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@android:color/transparent"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addSpend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/add_spend" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
