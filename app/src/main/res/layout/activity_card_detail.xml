<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- No title. The card names itself on the hero directly below, in its own colour
             and at four times the size; repeating "Card details" above it would be the
             least useful text on the screen sitting in the most prominent place. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.MyCards.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back" />

        <ScrollView
            android:id="@+id/detailScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingBottom="96dp">

                <!--
                    The card itself, wearing the same face it wears in the wallet.

                    This screen used to open on a page of text, so the card you had just
                    tapped a green rectangle to reach arrived as a heading and a number. The
                    hero carries the recognition across: the thing on screen is visibly the
                    thing you picked.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:id="@+id/heroContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_face_slate"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/cardTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAlignment="viewStart"
                                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                                    android:textColor="@color/on_face"
                                    tools:text="Holiday gift 2026" />

                                <TextView
                                    android:id="@+id/cardSubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAlignment="viewStart"
                                    android:textAppearance="@style/TextAppearance.MyCards.Meta"
                                    android:textColor="@color/on_face_variant"
                                    tools:text="BuyMe All" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/statusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_face_badge"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="@color/on_face"
                                android:visibility="gone"
                                tools:text="Archived"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/balance"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAlignment="viewStart"
                                android:textAppearance="@style/TextAppearance.MyCards.WalletTotal"
                                android:textColor="@color/on_face"
                                tools:text="₪252" />

                            <TextView
                                android:id="@+id/balanceMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textAppearance="@style/TextAppearance.MyCards.Meta"
                                android:textColor="@color/on_face_variant"
                                tools:text="of ₪700" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/depletion"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_depletion"
                            android:visibility="gone"
                            tools:progress="36"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/expiry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAlignment="viewStart"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/on_face_variant"
                            tools:text="Expires 04/27" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--
                    Why the card is out of the wallet, in a sentence, on the ordinary surface
                    rather than on the card.

                    The badge that names the state lives on the hero above; this is the part
                    that needs room to be a sentence, and a paragraph of small print across a
                    saturated fill is harder to read than the same words on the page. Only
                    archiving earns it — it is the one state the user caused, and so the one
                    they can be surprised by.
                -->
                <TextView
                    android:id="@+id/statusExplain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.MyCards.Meta"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="Kept out of your wallet list." />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mismatchCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/expiry_warning"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/unlogged_transaction_title"
                            android:textAlignment="viewStart"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="@color/expiry_warning" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/reconcileButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/reconcile_add" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- The doorway to the merchant list. It used to be a tap on the card name
                     above, which nobody discovers; a row of its own makes the affordance
                     plain, and stating the count puts a fact worth knowing on the screen
                     instead of leaving it buried in a dialog. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/storeListCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:minHeight="64dp"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/storeListTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAlignment="viewStart"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <TextView
                                android:id="@+id/storeListMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAlignment="viewStart"
                                android:textAppearance="@style/TextAppearance.MyCards.Meta"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/storeListChevron"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_end"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sensitive block: hidden until the OS confirms who is holding the phone. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/revealButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/show_card_number" />

                <LinearLayout
                    android:id="@+id/secretBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/colorSurfaceContainer"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/panValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.MyCards.Secret"
                        android:textIsSelectable="true" />

                    <!-- Number, expiry, then CVV — the order they are printed on the card
                         and the order a payment form asks for them. -->
                    <TextView
                        android:id="@+id/cardExpiryValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.MyCards.Secret"
                        android:textIsSelectable="true" />

                    <TextView
                        android:id="@+id/cvvValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.MyCards.Secret"
                        android:textIsSelectable="true" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/giftLinkButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_gift_link"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/spend_log"
                    android:textAlignment="viewStart"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/noSpends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/no_spends_yet"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.MyCards.Meta"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- The clearance for the floating button belongs on the scrolling
                     container, not here: padding on the list itself is drawn as part of
                     the list, showing up as a slab of dead space under the last entry. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/spendList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@android:color/transparent"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addSpend"
        style="@style/Widget.Material3Expressive.ExtendedFloatingActionButton.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/add_spend"
        app:icon="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
