<?xml version="1.0" encoding="utf-8"?>
<!--
    Asked after the user has been sent to the issuer's own page and come back.

    The app does not read that page. Where the balance is behind a sign-in there is no way to
    read it that does not involve holding somebody's issuer credentials, and that is a trade
    this app is not willing to make — so the user reads the number and types it, and the app
    does the arithmetic it is actually good at.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/issuer_balance_explain"
        android:textAlignment="viewStart"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/issuerBalanceLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/issuer_balance_label">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/issuerBalanceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textAlignment="viewStart" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
