<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Every label sets textAlignment="viewStart", exactly as the card rows do. Without it a
         TextView aligns by the direction of its own contents, so in Hebrew a purchase typed
         as "Bed linen" or logged at "Fox Home" drifted to the left edge while the Hebrew
         rows above it stayed right — the same list, half of it apparently in the wrong
         column. It cannot be set once on the container: TextView resolves alignment itself
         rather than inheriting it. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/spendTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Shoes at Castro" />

        <TextView
            android:id="@+id/spendMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.MyCards.Meta"
            tools:text="12/07/2026" />
    </LinearLayout>

    <TextView
        android:id="@+id/spendAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        tools:text="-₪120" />

</LinearLayout>
