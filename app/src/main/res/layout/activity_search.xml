<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        The toolbar stays put and the total scrolls away under it.

        A CollapsingToolbarLayout rather than two siblings in the app bar, because
        AppBarLayout requires every child carrying the "scroll" flag to be declared before
        any child without one — which would put the total above the toolbar in the file and
        so above it on screen. Collapsing is how you get a pinned bar over scrolling content
        with the bar still written first.

        titleEnabled="false" leaves the toolbar's own title alone. Otherwise the collapsing
        layout takes it over and animates it into the expanded area, which is where the
        balance goes.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <!--
            snap is not decoration. Without it the bar rests wherever the finger let go, and
            the total is a block of three lines being slid up behind a toolbar: at half way
            the subtitle is gone, the balance is cut off part-way down its digits, and the
            result reads as a rendering fault rather than a scroll position. snap sends it to
            whichever end is nearer when the gesture stops, so the only two states it comes
            to rest in are the two that were designed.
        -->
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:titleEnabled="false"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

            <!--
                The wallet's total, and the first thing on the screen.

                Checking a balance is the single most common reason a wallet app is opened,
                and until now this app could not answer it without adding three numbers up
                by eye. The top margin clears the pinned toolbar above; a CollapsingToolbar
                stacks its children like a FrameLayout rather than a column.

                One line rather than three. Stacked — label, then figure, then count — the
                block ran to about a third of the screen above a list that is the point of
                the screen, and two of those lines were four words between them. Read across,
                the figure keeps the whole of its size and the two small facts sit on its
                baseline, where they are captions to it rather than lines of their own.

                A horizontal LinearLayout baseline-aligns its children by default, which is
                what puts "Available" and "3 cards" on the number's feet instead of its
                middle. The Space is what holds the count against the far edge without
                weighting either label — a weighted TextView that is hidden stops pushing,
                and the count would slide inward on a wallet with nothing in it.

                Padded to 16dp to match the toolbar title above it and the search field and
                cards below, so the screen has one left edge rather than two 4dp apart.
            -->
            <LinearLayout
                android:id="@+id/totalBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/actionBarSize"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.6">

                <TextView
                    android:id="@+id/totalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.MyCards.WalletTotal"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="₪441" />

                <TextView
                    android:id="@+id/totalLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/wallet_total_label"
                    android:textAlignment="viewStart"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/totalSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textAlignment="viewEnd"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="3 cards" />
            </LinearLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Widget.MyCards.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:title="@string/app_name" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/searchContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!--
            The search field is the whole point of this screen, so it sits directly above
            the list and stays put while the list moves.

            Styled as a rounded filled field rather than Material's SearchBar widget. That
            widget is a button that opens a full-screen SearchView, and this screen filters
            the wallet as you type — swapping in the component would have meant swapping the
            interaction with it, which is not what a visual pass should decide.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            style="@style/Widget.MyCards.SearchField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:textAlignment="viewStart" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:text="@string/search_empty_prompt"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <!--
        The add button, at the Small size rather than the Medium one it started at.

        Medium is the size for a screen whose main verb is "add something". This screen's is
        "find the card I already have", and at 80dp the button covered a third of whichever
        card it sat over — on the one screen that exists to be read. It disappears entirely
        while a search is running; see SearchActivity#showAddButton.
    -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addCard"
        style="@style/Widget.Material3Expressive.ExtendedFloatingActionButton.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/content_desc_add"
        android:text="@string/add_card"
        app:icon="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
