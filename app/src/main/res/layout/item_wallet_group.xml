<?xml version="1.0" encoding="utf-8"?>
<!--
    The one collapsed group at the foot of the wallet: cards that are used up, expired, or
    put away by hand.

    It is a plain section header rather than a card, and that is the point. The rows above it
    are answers to "what can I spend?"; this is a lid on things that are not answers. Giving
    it the same card treatment would put it back in the running.

    minHeight is 48dp — the smallest comfortable touch target — because the whole row is the
    control, not just the chevron.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/groupChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_expand_more" />

    <TextView
        android:id="@+id/groupLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAlignment="viewStart"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        tools:text="Archive (4)" />

</LinearLayout>
