<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/transparent">

    <!-- Each label sets textAlignment="viewStart" individually. It cannot be set once on
         this container: TextView defaults to gravity-based alignment rather than
         inheriting, so a parent value is ignored. "viewStart" follows the layout direction
         instead of the text's own, which is what keeps a Latin card name on the right in
         an RTL screen — TextView otherwise picks direction from the first strong character
         it finds and left-aligns it. -->
    <!-- The face is set from code, per card type, by CardRowAdapter; the value here is only
         what the layout preview and the very first frame show. It is set on this child
         rather than on the MaterialCardView itself so the card keeps its own elevation and
         ripple, and so a retired row can be repainted grey without touching the card's
         shape. -->
    <!-- ⚠️ Do not express a retired card as alpha on itemView. RecyclerView's item animator
         treats itemView's alpha as its own and resets it to 1 at the end of every add and
         change animation, so the dimming disappears with no trace in the code. -->
    <LinearLayout
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_face_slate"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.MyCards.CardTitle"
                    android:textColor="@color/on_face"
                    tools:text="Holiday gift 2026" />

                <TextView
                    android:id="@+id/cardSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.MyCards.Meta"
                    android:textColor="@color/on_face_variant"
                    android:visibility="gone"
                    tools:text="BuyMe All"
                    tools:visibility="visible" />
            </LinearLayout>

            <!--
                One badge slot, carrying whichever single fact most needs saying about this
                card: why it is in the archive, or that it is about to lapse. The two cannot
                both apply — an expiring card is by definition still live — so they share
                the corner rather than each claiming one.

                A word rather than a shade: colour alone is unreadable to a good number of
                people and invisible to a screen reader, and on a wallet of eight different
                hues there is no colour that would mean the same thing on all of them
                anyway.
            -->
            <TextView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_face_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/on_face"
                android:visibility="gone"
                tools:text="Archived"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- The number you actually need at the counter, and what it started as. Baselines
             are aligned so the small figure sits on the big one's line rather than floating
             beside it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.MyCards.Balance"
                android:textColor="@color/on_face"
                tools:text="₪252" />

            <TextView
                android:id="@+id/initialAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.MyCards.Meta"
                android:textColor="@color/on_face_variant"
                android:visibility="gone"
                tools:text="of ₪700"
                tools:visibility="visible" />
        </LinearLayout>

        <!--
            How much of the card is gone. A balance on its own does not say whether ₪252 is
            most of the card or the last of it, and that is the thing that decides whether
            you reach for this card or another one.

            Hidden entirely when the starting amount is unknown, which is common — people
            often only ever know what is left. An empty track in that case would be a claim
            that the card is spent.
        -->
        <ProgressBar
            android:id="@+id/depletion"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_depletion"
            android:visibility="gone"
            tools:progress="36"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/expiry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.MyCards.Meta"
                android:textColor="@color/on_face_variant"
                tools:text="Expires 04/27" />

            <TextView
                android:id="@+id/onlineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_face_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/online_badge"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/on_face"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Why this card matched: the difference between a useful answer and a guess. -->
        <TextView
            android:id="@+id/matchReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_face_variant"
            tools:text="Accepted at Castro" />

        <!--
            Drawn as a pill rather than as coloured text. The amber this used to use is
            unreadable on the amber face and invisible on the rose one; a lighter patch of
            the card's own colour reads identically on all eight.
        -->
        <TextView
            android:id="@+id/warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_face_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textAlignment="viewStart"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/on_face"
            android:visibility="gone"
            tools:text="Unlogged transaction"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
