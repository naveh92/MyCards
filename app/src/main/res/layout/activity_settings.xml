<?xml version="1.0" encoding="utf-8"?>
<!--
    Four settings groups, each in its own container.

    They used to be one column of controls with hairline rules between them, which is the
    Material 2 arrangement and leaves every group looking like a continuation of the last —
    on a screen where the four have nothing to do with each other. Grouping them into
    separate surfaces is how Material 3, and every current settings screen, marks a boundary:
    the shape does the work the rule was failing to do, and the heading above each group can
    then be a heading rather than a divider label.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.MyCards.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <!-- ══ Language ══ -->
            <TextView
                style="@style/TextAppearance.MyCards.SettingsHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyCards.SettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioGroup
                    android:id="@+id/languageGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <RadioButton
                        android:id="@+id/langSystem"
                        style="@style/Widget.MyCards.SettingsChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/language_system" />

                    <RadioButton
                        android:id="@+id/langEnglish"
                        style="@style/Widget.MyCards.SettingsChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/language_english" />

                    <RadioButton
                        android:id="@+id/langHebrew"
                        style="@style/Widget.MyCards.SettingsChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/language_hebrew" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ Appearance ══ -->
            <TextView
                style="@style/TextAppearance.MyCards.SettingsHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/appearance" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyCards.SettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioGroup
                    android:id="@+id/themeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <RadioButton
                        android:id="@+id/themeSystem"
                        style="@style/Widget.MyCards.SettingsChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_system" />

                    <RadioButton
                        android:id="@+id/themeLight"
                        style="@style/Widget.MyCards.SettingsChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_light" />

                    <RadioButton
                        android:id="@+id/themeDark"
                        style="@style/Widget.MyCards.SettingsChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_dark" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ Store data ══ -->
            <TextView
                style="@style/TextAppearance.MyCards.SettingsHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/store_data" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyCards.SettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/store_data_explain"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.MyCards.Meta"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/lastSync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAlignment="viewStart"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <!-- Only shown when this build has no catalog URL at all; the code
                         hides it otherwise. -->
                    <TextView
                        android:id="@+id/catalogNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.MyCards.Meta"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/syncNow"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="52dp"
                        android:text="@string/update_store_data" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ Backup ══ -->
            <TextView
                style="@style/TextAppearance.MyCards.SettingsHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyCards.SettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_explain"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.MyCards.Meta"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/exportBackup"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:minHeight="52dp"
                        android:text="@string/backup_export" />

                    <!-- Sits directly under Export, because it is the step that belongs with
                         it: an export you have not checked is a file, not a backup. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checkBackup"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="48dp"
                        android:text="@string/backup_check" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/importBackup"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/backup_import" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
