<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately near-invisible: the track is there to give the thumb somewhere to sit, not
     to draw a line down the side of every screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="8dp"
        android:height="52dp" />
    <solid android:color="@color/fastscroll_track" />
</shape>
