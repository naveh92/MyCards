<?xml version="1.0" encoding="utf-8"?>
<!-- The neutral twin of bg_badge. That one is outlined in green because "Online" is good
     news; a card being used up is neither good nor bad, so this one stays grey and does not
     compete with the balance next to it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="@color/card_status" />
    <solid android:color="@android:color/transparent" />
</shape>
