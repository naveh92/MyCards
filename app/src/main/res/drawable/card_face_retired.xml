<?xml version="1.0" encoding="utf-8"?>
<!--
    What an archived, empty or lapsed card wears instead of its colour.

    Not a grey version of a card face. The first attempt was exactly that — the same
    gradient shape filled with greys — and it read as a colour photograph with the colour
    drained out of it: obviously the same object, obviously broken. Muddy rather than quiet.

    So a retired card stops being a painted card altogether and becomes a plain one: the
    page's own surface, a hairline outline, and ordinary text colours. The wallet then has
    two clearly different kinds of object in it rather than one kind in two states, which is
    the actual distinction — these are not spendable and the coloured ones are.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="?attr/colorSurfaceContainer" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
</shape>
